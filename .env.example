# Copy to .env and fill in. Every setting in src/ragapp/config.py can be set here.

# Credentials for Claude. The SDK reads this from the environment.
ANTHROPIC_API_KEY=

# LLM_PROVIDER=fake            # offline stand-in, no key needed, no quality signal
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# JUDGE_MODEL=claude-opus-5-5
# LLM_REFUSAL_FALLBACK=true

# EMBEDDING_PROVIDER=fastembed # or "hash" for offline runs
# QDRANT_URL=http://localhost:6333   # unset = embedded on-disk Qdrant at ./.qdrant
# TOP_K=4

# PROMPT_VERSION=v2
# MLFLOW_TRACKING_URI=http://localhost:5000   # unset = sqlite:///mlflow.db
